export EDITOR="vim"

# Set the default locale to UTF-8
export LC_CTYPE=en_US.UTF-8
export LC_ALL=en_US.UTF-8

source ~/dotfiles/config/zsh/brew
source ~/dotfiles/config/zsh/ps1
source ~/dotfiles/config/zsh/hist
source ~/dotfiles/config/zsh/aliases
source ~/dotfiles/config/zsh/autocmp
source ~/dotfiles/config/zsh/keybindings
source ~/dotfiles/config/zsh/git

export PATH="/Users/shiroyasha/.opencode/bin":$PATH
export PATH="/Users/shiroyasha/zig:$PATH"

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/shiroyasha/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/shiroyasha/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/shiroyasha/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/shiroyasha/google-cloud-sdk/completion.zsh.inc'; fi
