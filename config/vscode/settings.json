{
  "terminal.integrated.fontSize": 14,
  //
  // font and ligatures
  //
  "editor.fontFamily": "'JetBrains Mono', Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'zero', 'cv02', 'cv29', 'ss08'",
  "editor.fontSize": 16,
  //
  // guides and highlights
  //
  "editor.guides.highlightActiveBracketPair": false,
  "editor.renderLineHighlight": "gutter",
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  "editor.foldingHighlight": false,
  "editor.guides.highlightActiveIndentation": false,
  "editor.minimap.enabled": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.rulers": [120],
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always"
  },
  "editor.autoClosingBrackets": "never",
  "editor.autoClosingQuotes": "never",
  "editor.autoSurround": "never",
  "editor.autoClosingOvertype": "never",
  "editor.formatOnType": false,
  "editor.detectIndentation": false,
  "editor.guides.indentation": false,
  "editor.stickyScroll.enabled": false,
  "breadcrumbs.enabled": true,
  "workbench.colorTheme": "GitHub Light",
  "workbench.iconTheme": "vs-seti",
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.panel.defaultLocation": "right",
  "workbench.tips.enabled": false,
  "workbench.editor.showIcons": false,
  "workbench.activityBar.location": "top",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  //
  // hide the top bar in vscode
  //
  "window.commandCenter": false,
  "window.customTitleBarVisibility": "windowed",
  "javascript.preferences.importModuleSpecifier": "relative",
  "typescript.preferences.importModuleSpecifier": "relative",
  "explorer.confirmDelete": false,
  //
  // git
  //
  "git.autofetch": true,
  "[elixir]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.wordBasedSuggestions": "off",
    "editor.formatOnType": true,
    "editor.trimAutoWhitespace": false,
    "editor.snippetSuggestions": "inline",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true
  },
  "elixirLS.suggestSpecs": false,
  "github.copilot.nextEditSuggestions.enabled": true,
  "files.associations": {
    "*.mdx": "markdown"
  },
  "gitTreeCompare.showCheckboxes": false,
  "chat.agentSessionsViewLocation": "view",
  "githubPullRequests.codingAgent.uiIntegration": true,
  "githubPullRequests.terminalLinksHandler": "github",
  "editor.accessibilitySupport": "off",
  "chat.tools.terminal.autoApprove": {
    "make test.mix FILE=test/operately_web/api/mutations/create_account_test.exs": {
      "approve": true,
      "matchCommandLine": true
    },
    "make test.mix FILE=test/operately_web/api/invitations_test.exs": {
      "approve": true,
      "matchCommandLine": true
    },
    "make test.mix FILE=test/features/invite_links_test.exs": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "chatgpt.commentCodeLensEnabled": false,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "typescriptreact": true,
    "elixir": false
  },
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.tabs.enabled": false,
  "terminal.integrated.suggest.enabled": false,
  "go.toolsManagement.autoUpdate": true
}
